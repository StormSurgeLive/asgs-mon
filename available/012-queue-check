source "${ASGS_MON_LIB:-${ASGS_MON_PLUGINDIR}/_bash-helper-functions.sh}"
mon_init "$@"


mon_every 5

queue_output=""
queue_rc=0

# Prefer ASGS' scheduler-neutral helper explicitly. Do not call a random `sq`
# from PATH (some systems ship an unrelated command with that name).
if [[ -n "${SCRIPTDIR:-}" && -x "$SCRIPTDIR/bin/sq" ]]; then
    queue_output=$("$SCRIPTDIR/bin/sq" 2>&1) || queue_rc=$?
elif [[ "${QUEUESYS:-}" == "SLURM" ]] && mon_have squeue; then
    queue_output=$(squeue -u "${USER:-$(id -un)}" --noheader -o " %.18i %.30j %T %.10M" 2>&1) || queue_rc=$?
elif [[ "${QUEUESYS:-}" == "PBS" ]] && mon_have qstat; then
    queue_output=$(qstat 2>&1 | grep "${USER:-$(id -un)}" || true)
elif [[ "${QUEUESYS:-}" == "PBS" ]] && mon_have showq; then
    queue_output=$(showq 2>&1 | grep "${USER:-$(id -un)}" || true)
elif mon_have squeue; then
    queue_output=$(squeue -u "${USER:-$(id -un)}" 2>&1) || queue_rc=$?
else
    mon_verbose "($HPCENVSHORT $COLORED_PROFILE - ${YW}$THIS${R}) no supported ASGS/scheduler queue command found; check skipped"
    mon_ok "unsupported"
fi

if (( queue_rc != 0 )); then
    mon_unknown "scheduler queue command failed" <<EOF
$queue_output
EOF
fi

if [[ "$VERBOSE" == 1 && "$queue_output" != *Guessing* ]]; then
    printf '(%s %s - %s%s%s)\n%s\n' \
        "$HPCENVSHORT" "$COLORED_PROFILE" "$GR" "$THIS" "$R" "$queue_output" >&2
fi

if [[ -z "$queue_output" || "$queue_output" == No\ jobs\ in\ queue* ]]; then
    running=0
else
    running=$(printf '%s\n' "$queue_output" | awk 'NF {n++} END {print n+0}')
fi
mon_ok "$running"
