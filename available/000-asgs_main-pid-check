source "${ASGS_MON_LIB:-${ASGS_MON_PLUGINDIR}/_bash-helper-functions.sh}"
mon_init "$@"


mon_require_var ASGS_PID

if [[ ! "$ASGS_PID" =~ ^[0-9]+$ || ! -r "/proc/$ASGS_PID/cmdline" ]]; then
    mon_critical "asgs_main.sh went away" <<EOF
Suggested Remedy:
Log into ${HPCENV:-the ASGS host} and inspect ${SCRIPTDIR:-the ASGS installation}.

Information:
The configured ASGS process ID $ASGS_PID no longer exists.

Profile: $PROFILE
Config : $CONFIGFILE
EOF
fi

cmdline=$(tr '\0' ' ' < "/proc/$ASGS_PID/cmdline" 2>/dev/null || true)
config_base=$(basename -- "$CONFIGFILE")
if [[ "$cmdline" != *asgs_main.sh* || "$cmdline" != *"$config_base"* ]]; then
    mon_critical "ASGS PID no longer matches this profile" <<EOF
PID $ASGS_PID exists, but its command line no longer identifies the expected
asgs_main.sh instance.

Expected config: $CONFIGFILE
Command line   : $cmdline
EOF
fi

mon_verbose "($HPCENVSHORT $COLORED_PROFILE - ${GR}$THIS${R}) Found asgs_main.sh (pid $ASGS_PID)"
mon_ok "pid=$ASGS_PID"
