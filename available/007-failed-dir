source "${ASGS_MON_LIB:-${ASGS_MON_PLUGINDIR}/_bash-helper-functions.sh}"
mon_init "$@"


mon_require_var RUNDIR
mon_require_dir "$RUNDIR" RUNDIR

failed=()
while IFS= read -r -d '' path; do
    failed+=("$path")
done < <(find "$RUNDIR" -maxdepth 1 -mindepth 1 -type d -name 'failed*' -print0 2>/dev/null)

count=${#failed[@]}
if (( count > 0 )); then
    newest=""
    newest_time=0
    for path in "${failed[@]}"; do
        mtime=$(stat -c %Y -- "$path" 2>/dev/null || printf '0')
        if (( mtime >= newest_time )); then
            newest_time=$mtime
            newest=$path
        fi
    done

    logdump="(scenario.log not present)"
    if [[ -n "$newest" && -r "$newest/scenario.log" ]]; then
        logdump=$(tail -n 20 -- "$newest/scenario.log" 2>/dev/null || true)
    fi

    failed_body=$(
        printf 'Failed directories found:\n\n'
        printf '  %s\n' "${failed[@]}"
        printf '\nLatest tail of %s/scenario.log:\n\n%s\n' "$newest" "$logdump"
    )

    mon_warning "$count failed director$( (( count == 1 )) && printf 'y' || printf 'ies') detected" <<EOF
Suggested Remedy:
Inspect the failed run directory and scenario.log before restarting or removing it.

System : ${HPCENV:-}
ASGS   : ${SCRIPTDIR:-}
Profile: $PROFILE
RUNDIR : $RUNDIR

$failed_body
EOF
fi

mon_ok "$count"
