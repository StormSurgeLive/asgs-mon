# This file is part of the ADCIRC Surge Guidance System (ASGS).
#
# Report compact progress snippets from ADCIRC logs for the current advisory.
# This check deliberately ignores SWAN PE logs; SWAN monitoring should be a
# separate check if desired.
#--------------------------------------------------------------------------

source "${ASGS_MON_LIB:-${ASGS_MON_PLUGINDIR}/_bash-helper-functions.sh}"
mon_init "$@"

mon_require_var RUNDIR
mon_require_dir "$RUNDIR" RUNDIR

advisory=${ADVISORY:-initialize}

if [[ -z "$advisory" || "$advisory" == "0" || "$advisory" == "null" ]]; then
    advisory=initialize
fi

search_root="$RUNDIR/$advisory"

# During transitions, the advisory directory may not exist yet.
if [[ ! -d "$search_root" ]]; then
    if [[ "$VERBOSE" == 1 ]]; then
        printf '(%s %s - %s%s%s) ADCIRC advisory directory not present yet: %s\n' \
            "$HPCENVSHORT" "$COLORED_PROFILE" \
            "$GR" "$THIS" "$R" \
            "$search_root" >&2
    fi

    mon_ok "0 ADCIRC logs"
fi

shown=0

while IFS= read -r -d '' log; do
    shown=$((shown + 1))

    if [[ "$VERBOSE" == 1 ]]; then
        printf '(%s %s - %s%s%s) - %sADCIRC LOG%s:\n' \
            "$HPCENVSHORT" "$COLORED_PROFILE" \
            "$GR" "$THIS" "$R" \
            "$YW" "$R" >&2

        tail -n 3 -- "$log" >&2
    fi
done < <(
    find "$search_root" \
        -type f \
        -name 'adcirc.log' \
        -print0 2>/dev/null
)

mon_ok "$shown ADCIRC log(s)"
